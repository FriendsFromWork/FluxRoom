VITE_SIGNALING_URL=ws://localhost:3001

# TURN relays are normally configured on the signaling server (TURN_CREDENTIALS_URL), which
# hands them to browsers at runtime. Only use these to bake a relay into the client build.
# Comma-separated URLs are supported.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
