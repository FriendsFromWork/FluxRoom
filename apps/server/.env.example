PORT=3001

# Comma-separated list of allowed origins for the WebSocket upgrade and /ice-servers (CORS-equivalent).
# Leave unset to allow any origin (fine for local dev, tighten for production).
ORIGIN=https://your-app.vercel.app

# Relay chat/files through this server for peers that can't connect directly
# (e.g. phones on different mobile networks). On by default; set to false to disable.
RELAY_ENABLED=true

# Optional TURN relay instead of / in addition to the built-in relay (see DEPLOYMENT.md).
TURN_CREDENTIALS_URL=
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
